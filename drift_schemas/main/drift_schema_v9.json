  "fixed_sql": [
    {
      "name": "radios",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"radios\" (\"id\" TEXT NOT NULL, \"protocol\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"self_key\" TEXT NOT NULL, \"firmware\" TEXT NOT NULL DEFAULT '', \"model\" TEXT NOT NULL DEFAULT '', \"max_channels\" INTEGER NULL, \"latitude\" REAL NULL, \"longitude\" REAL NULL, \"last_connected\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "nodes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"nodes\" (\"radio_id\" TEXT NOT NULL, \"node_key\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"short_name\" TEXT NOT NULL DEFAULT '', \"kind\" TEXT NOT NULL, \"latitude\" REAL NULL, \"longitude\" REAL NULL, \"altitude\" INTEGER NULL, \"last_heard\" INTEGER NULL, \"hops\" INTEGER NULL, \"snr\" REAL NULL, \"rssi\" INTEGER NULL, \"route\" TEXT NOT NULL, \"via_mqtt\" INTEGER NOT NULL DEFAULT 0 CHECK (\"via_mqtt\" IN (0, 1)), \"favorite\" INTEGER NOT NULL DEFAULT 0 CHECK (\"favorite\" IN (0, 1)), \"battery\" INTEGER NULL, \"can_message\" INTEGER NOT NULL DEFAULT 1 CHECK (\"can_message\" IN (0, 1)), \"route_hex\" TEXT NULL, \"public_key_hex\" TEXT NULL, PRIMARY KEY (\"radio_id\", \"node_key\"));"
        }
      ]
    },
    {
      "name": "channels",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"channels\" (\"radio_id\" TEXT NOT NULL, \"slot\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"is_primary\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_primary\" IN (0, 1)), PRIMARY KEY (\"radio_id\", \"slot\"));"
        }
      ]
    },
    {
      "name": "messages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"messages\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"radio_id\" TEXT NOT NULL, \"conversation\" TEXT NOT NULL, \"outgoing\" INTEGER NOT NULL CHECK (\"outgoing\" IN (0, 1)), \"body\" TEXT NOT NULL, \"sent_at\" INTEGER NOT NULL, \"received_at\" INTEGER NOT NULL, \"delivery\" TEXT NOT NULL, \"delivery_reason\" TEXT NULL, \"round_trip_ms\" INTEGER NULL, \"from_key\" TEXT NULL, \"sender_name\" TEXT NULL, \"hops\" INTEGER NULL, \"snr\" REAL NULL, \"rssi\" INTEGER NULL, \"route\" TEXT NOT NULL, \"via_mqtt\" INTEGER NOT NULL DEFAULT 0 CHECK (\"via_mqtt\" IN (0, 1)), \"native_id\" INTEGER NULL, \"reply_to\" INTEGER NULL, \"is_reaction\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_reaction\" IN (0, 1)), \"attempts\" INTEGER NOT NULL DEFAULT 0, \"authenticated\" INTEGER NOT NULL DEFAULT 0 CHECK (\"authenticated\" IN (0, 1)), \"dedupe_key\" TEXT NULL UNIQUE);"
        }
      ]
    },
    {
      "name": "verified_keys",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"verified_keys\" (\"node_key\" TEXT NOT NULL, \"public_key_hex\" TEXT NOT NULL, \"verified_at\" INTEGER NOT NULL, \"method\" TEXT NOT NULL, PRIMARY KEY (\"node_key\"));"
        }
      ]
    },
    {
      "name": "telemetry_readings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"telemetry_readings\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"radio_id\" TEXT NOT NULL, \"node_key\" TEXT NOT NULL, \"time\" INTEGER NOT NULL, \"battery_level\" INTEGER NULL, \"voltage\" REAL NULL, \"channel_utilization\" REAL NULL, \"air_util_tx\" REAL NULL, \"uptime_seconds\" INTEGER NULL, \"temperature\" REAL NULL, \"relative_humidity\" REAL NULL, \"barometric_pressure\" REAL NULL);"
        }
      ]
    },
    {
      "name": "conversation_states",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"conversation_states\" (\"conversation\" TEXT NOT NULL, \"last_read_id\" INTEGER NOT NULL DEFAULT 0, \"muted_until\" INTEGER NULL, PRIMARY KEY (\"conversation\"));"
        }
      ]
    },
    {
      "name": "preferences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"preferences\" (\"name\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"name\"));"
        }
      ]
    },
    {
      "name": "radio_contacts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"radio_contacts\" (\"radio_id\" TEXT NOT NULL, \"node_key\" TEXT NOT NULL, PRIMARY KEY (\"radio_id\", \"node_key\"));"
        }
      ]
    },
    {
      "name": "trace_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"trace_records\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"radio_id\" TEXT NOT NULL, \"node_key\" TEXT NOT NULL, \"target_name\" TEXT NOT NULL, \"time\" INTEGER NOT NULL, \"towards\" TEXT NOT NULL, \"back\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "places",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"places\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"kind\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"points\" TEXT NOT NULL, \"radius_m\" REAL NULL, \"alerts\" INTEGER NOT NULL DEFAULT 1 CHECK (\"alerts\" IN (0, 1)));"
        }
      ]
    },
