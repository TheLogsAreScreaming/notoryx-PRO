  "fixed_sql": [
    {
      "name": "radios",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"radios\" (\"id\" TEXT NOT NULL, \"protocol\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"self_key\" TEXT NOT NULL, \"firmware\" TEXT NOT NULL DEFAULT '', \"model\" TEXT NOT NULL DEFAULT '', \"max_channels\" INTEGER NULL, \"latitude\" REAL NULL, \"longitude\" REAL NULL, \"last_connected\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "nodes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"nodes\" (\"radio_id\" TEXT NOT NULL, \"node_key\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"short_name\" TEXT NOT NULL DEFAULT '', \"kind\" TEXT NOT NULL, \"latitude\" REAL NULL, \"longitude\" REAL NULL, \"altitude\" INTEGER NULL, \"last_heard\" INTEGER NULL, \"hops\" INTEGER NULL, \"snr\" REAL NULL, \"rssi\" INTEGER NULL, \"route\" TEXT NOT NULL, \"via_mqtt\" INTEGER NOT NULL DEFAULT 0 CHECK (\"via_mqtt\" IN (0, 1)), \"favorite\" INTEGER NOT NULL DEFAULT 0 CHECK (\"favorite\" IN (0, 1)), \"battery\" INTEGER NULL, \"can_message\" INTEGER NOT NULL DEFAULT 1 CHECK (\"can_message\" IN (0, 1)), PRIMARY KEY (\"radio_id\", \"node_key\"));"
        }
      ]
    },
    {
      "name": "channels",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"channels\" (\"radio_id\" TEXT NOT NULL, \"slot\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"is_primary\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_primary\" IN (0, 1)), PRIMARY KEY (\"radio_id\", \"slot\"));"
        }
      ]
    },
    {
      "name": "messages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"messages\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"radio_id\" TEXT NOT NULL, \"conversation\" TEXT NOT NULL, \"outgoing\" INTEGER NOT NULL CHECK (\"outgoing\" IN (0, 1)), \"body\" TEXT NOT NULL, \"sent_at\" INTEGER NOT NULL, \"received_at\" INTEGER NOT NULL, \"delivery\" TEXT NOT NULL, \"delivery_reason\" TEXT NULL, \"round_trip_ms\" INTEGER NULL, \"from_key\" TEXT NULL, \"sender_name\" TEXT NULL, \"hops\" INTEGER NULL, \"snr\" REAL NULL, \"rssi\" INTEGER NULL, \"route\" TEXT NOT NULL, \"via_mqtt\" INTEGER NOT NULL DEFAULT 0 CHECK (\"via_mqtt\" IN (0, 1)), \"native_id\" INTEGER NULL, \"reply_to\" INTEGER NULL, \"is_reaction\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_reaction\" IN (0, 1)), \"attempts\" INTEGER NOT NULL DEFAULT 0, \"dedupe_key\" TEXT NULL UNIQUE);"
        }
      ]
    },
    {
      "name": "messages_by_conversation",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX messages_by_conversation ON messages (conversation, id)"
        }
      ]
    },
    {
      "name": "messages_by_native_id",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX messages_by_native_id ON messages (radio_id, native_id)"
        }
      ]
    }
  ]
